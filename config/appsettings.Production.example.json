{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:5003"
      }
    }
  },
  "ConnectionStrings": {
    "MySql": "Server=host.docker.internal;Port=3306;User Id=stream_bot;Password=CHANGE_ME;Database=discord_stream_bot;",
    "Redis": "host.docker.internal:6379,syncTimeout=3000"
  },
  "BililiveWebHookUrl": "OPTIONAL_DISCORD_WEBHOOK_URL",
  "RedirectUrl": "https://frontend.example.com/stream/login",
  "Discord": {
    "ClientId": "CHANGE_ME_DISCORD_CLIENT_ID",
    "ClientSecret": "CHANGE_ME_DISCORD_CLIENT_SECRET"
  },
  "Google": {
    "ClientId": "CHANGE_ME_GOOGLE_CLIENT_ID",
    "ClientSecret": "CHANGE_ME_GOOGLE_CLIENT_SECRET"
  },
  "Twitch": {
    "ClientId": "CHANGE_ME_TWITCH_CLIENT_ID",
    "ClientSecret": "CHANGE_ME_TWITCH_CLIENT_SECRET",
    "WebHookSecret": "CHANGE_ME_TWITCH_WEBHOOK_SECRET"
  },
  "Token": {
    "Frontend": "REPLACE_WITH_AT_LEAST_64_CHARACTERS",
    "Redis": "REPLACE_WITH_THE_EXISTING_SHARED_KEY_OF_AT_LEAST_64_CHARACTERS"
  },
  "TwitCasting": {
    "WebHookSignature": "CHANGE_ME_TWITCASTING_WEBHOOK_SIGNATURE"
  }
}
